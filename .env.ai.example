# Cấu hình riêng cho dịch vụ chẩn đoán AI (app.py). Sao chép thành .env.ai rồi điền khóa.
# KHÔNG commit file .env.ai. systemd nạp file này qua EnvironmentFile (xem SETUP_NOTES.md).

# Bắt buộc
OPENAI_API_KEY=

# Tùy chọn (bỏ trống thì dùng mặc định trong code)
DIAGNOSIS_BACKEND=openai
DIAGNOSIS_MODEL=gpt-6-luna
# none = nhanh nhất; chỉ áp dụng cho model reasoning (gpt-5*, gpt-6*, o*)
DIAGNOSIS_REASONING_EFFORT=none
# Cạnh dài nhất của ảnh gửi cho AI (px). Nhỏ hơn = nhanh và rẻ hơn, nhưng khó thấy đốm bệnh nhỏ
DIAGNOSIS_IMAGE_MAX_SIDE=1024
# low | high | auto
DIAGNOSIS_IMAGE_DETAIL=high
DIAGNOSIS_TIMEOUT=60

# Chống lạm dụng (endpoint /predict công khai, mỗi lượt gọi OpenAI tốn tiền)
DIAGNOSIS_RATE_PER_MINUTE=6
DIAGNOSIS_DAILY_LIMIT=1000
DIAGNOSIS_MAX_UPLOAD_MB=12
